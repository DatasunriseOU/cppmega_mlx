{
  "name": "@cppmega/visual-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visual Builder GUI for cppmega.mlx (React Flow + JSON-RPC client)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:widget": "vite build -c vite.widget.config.ts",
    "preview": "vite preview",
