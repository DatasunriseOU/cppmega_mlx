# Local Python environments and interpreter caches.
.venv
.venv/
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/

# Build artifacts.
*.egg-info/
build/
